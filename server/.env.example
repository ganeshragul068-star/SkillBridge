# =======================================================
# SkillBridge Backend Environment Configuration
# Copy this file to .env and provide your MongoDB Atlas credentials
# =======================================================

# Server Network Port (Default: 5000)
PORT=5000
NODE_ENV=development

# Data Mode: 'demo' (decoupled JSON repository) or 'mongodb' (production Atlas)
DATA_MODE=demo

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillbridge?retryWrites=true&w=majority

# JWT Token Authentication Configuration
# Use a strong, unique secret key in production
JWT_SECRET=skillbridge_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=30d

# Initial Admin Seeding Configuration (Used by npm run seed)
ADMIN_NAME=SkillBridge Administrator
ADMIN_EMAIL=admin@skillbridge.edu
ADMIN_INITIAL_PASSWORD=Admin@Pass2026!

# Google Gemini API Key for AI Resume Analysis & AI Resume Builder
# Obtain key from: https://aistudio.google.com/api-keys
GEMINI_API_KEY=your_gemini_api_key_here
