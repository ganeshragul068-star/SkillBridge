# =======================================================
# SkillBridge – Root Environment Variables Reference
# =======================================================
# SkillBridge is a MERN application with separate client/ and server/ directories.
# For detailed configuration templates, see:
# - server/.env.example
# - client/.env.example
#
# Backend Configuration (server/.env):
PORT=5000
NODE_ENV=development
DATA_MODE=demo
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillbridge?retryWrites=true&w=majority
JWT_SECRET=skillbridge_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=30d
ADMIN_NAME=SkillBridge Administrator
ADMIN_EMAIL=admin@skillbridge.edu
ADMIN_INITIAL_PASSWORD=Admin@Pass2026!
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (client/.env):
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=SkillBridge
VITE_APP_ENV=development
